{
	"name": "vault-plugin-sync",
	"version": "1.0.1",
	"description": "Sync installed Obsidian plugins from one vault to your other vaults.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": ["obsidian", "plugin", "sync", "vault"],
	"license": "Apache-2.0",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "0.20.0",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.3.3"
	}
}
